{
  "name": "freshmart",
  "version": "2.0.0",
  "description": "FreshMart Farm-to-Kitchen Complete Order to 90-Minute Delivery Platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "admin"
  ],
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test_order_lifecycle.js",
    "test:owner": "node test_owner_system_inprocess.js",
    "test:orders": "node test_order_lifecycle_inprocess.js",
    "test:auth": "node test_auth_system_inprocess.js",
    "dev:backend": "node backend/src/server.js",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:admin": "npm run dev --workspace=admin",
    "build": "npm run build --workspace=frontend && npm run build --workspace=admin"
  },
  "keywords": [
    "freshmart",
    "quick-commerce",
    "organic-vegetables",
    "delivery"
  ],
  "author": "FreshMart Team",
  "license": "MIT"
}

