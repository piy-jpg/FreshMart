# ========================================================
# SABJIHUB ENTERPRISE CONFIGURATION & SECRETS
# ========================================================

# Server Port
PORT=8080
NODE_ENV=development

# Geocoding & Place Search Configuration (FEATURE 3, 5, 15)
# Supported providers:
# - nominatim: OpenStreetMap Nominatim (Free, no API key required out of the box)
# - locationiq: LocationIQ API (Fast, requires free/paid API key)
# - google: Google Maps Geocoding & Places API (Requires GCP API key)
# Google Maps Platform API Key (JavaScript API, Places API, Geocoding API)
GOOGLE_MAPS_API_KEY=
GEOCODING_PROVIDER=google
GEOCODING_API_KEY=

# Custom User-Agent header required by geocoding providers (e.g. Nominatim policy)
GEOCODING_USER_AGENT=SabjiHub-Grocery/2.0 (delivery@sabjihub.com)

# Google OAuth Client ID (for official Google Identity Services login)
GOOGLE_CLIENT_ID=880806707459-ci9gcf8sni1h6u0gmd1qtp96mg2u9l9g.apps.googleusercontent.com

# Executive Owner Email
OWNER_EMAIL=piyushverma730929@gmail.com
