{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/owner",
      "destination": "/owner.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/delivery",
      "destination": "/delivery.html"
    },
    {
      "source": "/hub",
      "destination": "/hub.html"
    },
    {
      "source": "/offers",
      "destination": "/offers.html"
    },
    {
      "source": "/grocery",
      "destination": "/grocery.html"
    },
    {
      "source": "/fruits",
      "destination": "/fruits.html"
    },
    {
      "source": "/vegetables",
      "destination": "/vegetables.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  }
}