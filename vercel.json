{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["data/**", "database.js"]
      }
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-session-token, x-auth-token"
      }
    },
    {
      "src": "/api",
      "dest": "/api/index.js"
    },
    {
      "src": "/owner",
      "dest": "/owner.html"
    },
    {
      "src": "/staff",
      "dest": "/owner.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/checkout",
      "dest": "/checkout.html"
    },
    {
      "src": "/delivery",
      "dest": "/delivery.html"
    },
    {
      "src": "/hub",
      "dest": "/hub.html"
    },
    {
      "src": "/offers",
      "dest": "/offers.html"
    },
    {
      "src": "/grocery",
      "dest": "/grocery.html"
    },
    {
      "src": "/fruits",
      "dest": "/fruits.html"
    },
    {
      "src": "/vegetables",
      "dest": "/vegetables.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}